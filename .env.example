# --- Serving ---
MODEL_PATH=./bert_model              # local directory OR Hugging Face repo id (e.g. Glsmit/bert-imdb-sentiment)
MODEL_REVISION=                      # optional: HF branch / tag / commit SHA
MODEL_VERSION=v1                     # tag attached to all Prometheus metrics — bump on retrain
HF_TOKEN=                            # only needed for private HF repos
MAX_LENGTH=128

# --- Training (used by `python -m app.train`) ---
BASE_MODEL=bert-base-uncased
OUTPUT_DIR=./models/bert_model_sen
BATCH_SIZE=16
EPOCHS=3

# --- Monitoring stack ---
GRAFANA_PASSWORD=changeme
